<div class="alert alert-dismissible takeover-alert takeover-[% lc($type) %]" role="alert">
  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
  <div>
    <h2>[% $title %]</h2>
    <div>
      %%  block text -> { }
      %%  if $email_contact {
      If you're interested then please contact [% $email_contact %] via
      <a class="alert-link" href="mailto:[% $emails.join(',') %]?subject=[% $email_subject | uri_escape %]&amp;body=[% block email_body | uri_escape -> { } %]">email</a>.
      %%  }
    </div>
  </div>
</div>
